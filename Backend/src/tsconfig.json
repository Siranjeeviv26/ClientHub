{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@auth/*": ["src/auth/*"],
      "@users/*": ["src/users/*"],
      "@organizations/*": ["src/organizations/*"],
      "@roles/*": ["src/roles/*"],
      "@clients/*": ["src/clients/*"],
      "@leads/*": ["src/leads/*"],
      "@deals/*": ["src/deals/*"],
      "@tasks/*": ["src/tasks/*"],
      "@activities/*": ["src/activities/*"],
      "@notifications/*": ["src/notifications/*"],
      "@dashboard/*": ["src/dashboard/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"],
      "@database/*": ["src/database/*"],
      "@queue/*": ["src/queue/*"],
      "@email/*": ["src/email/*"],
      "@storage/*": ["src/storage/*"],
      "@seed/*": ["src/seed/*"]
    }
  },
  "include": ["src/**/*", "src/common/types/express.d.ts"],
  "exclude": ["node_modules", "dist", "test"]
}